    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value Sw2 (at 3.76 2.11 -180) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_line (start 7 7) (end 7 0) (layer F.SilkS) (width 0.12))
  (fp_line (start -7 7) (end 7 7) (layer F.SilkS) (width 0.12))
  (fp_line (start -7 0) (end -7 7) (layer F.SilkS) (width 0.12))
  (fp_line (start -7 -7) (end -7 0) (layer F.SilkS) (width 0.12))
  (fp_line (start 0 -7) (end -7 -7) (layer F.SilkS) (width 0.12))
  (fp_line (start 7 -7) (end 0 -7) (layer F.SilkS) (width 0.12))
  (fp_line (start 7 0) (end 7 -7) (layer F.SilkS) (width 0.12))
)
